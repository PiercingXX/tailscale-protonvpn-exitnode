# Copy to .env and fill in. .env is gitignored — never commit it.
#   cp .env.example .env

# --- ProtonVPN (OpenVPN) ------------------------------------------------
# These are your OpenVPN/IKEv2 credentials from
# ProtonVPN dashboard -> Account -> OpenVPN / IKEv2 username.
# They are NOT your ProtonVPN account login.
OPENVPN_USER=changeme
OPENVPN_PASSWORD=changeme

# udp (default) or tcp. Only use tcp if udp is blocked on your network —
# TCP-over-TCP degrades badly under packet loss.
OPENVPN_PROTOCOL=udp

# Country to exit from, by name. e.g. Switzerland, Netherlands, Japan
SERVER_COUNTRIES=Switzerland

# --- Tailscale ----------------------------------------------------------
# Generate at https://login.tailscale.com/admin/settings/keys and select
# tag:vpn under Tags. Add tag:vpn to your ACL first, or it won't be offered.
# An OAuth client secret from the trust-credentials page also works here.
TS_AUTHKEY=tskey-changeme

# Machine name as it appears in the Tailscale admin console.
TS_HOSTNAME=openvpn

# --- General ------------------------------------------------------------
TZ=Etc/UTC

# Ownership of files written to ./gluetun
PUID=1000
PGID=1000

# Optional. Your LAN, if you also want this node to reach/advertise it.
# Setting LAN_SUBNET alone does nothing. To use it, uncomment two lines in
# compose.yaml: FIREWALL_OUTBOUND_SUBNETS (gluetun service) and TS_ROUTES
# (tailscale service). The route also needs approving in the Tailscale admin
# console unless autoApprovers covers it.
LAN_SUBNET=192.168.1.0/24

# EXPERIMENTAL, off by default. Set to "on" to send tailscaled's own traffic
# (control plane, DERP, direct peer connections) outside the VPN tunnel.
# Lowers latency and allows direct connections, but exposes this host's real
# IP to Tailscale and its peers and bypasses the killswitch for that traffic.
# Traffic forwarded for exit-node clients still goes through the VPN.
TS_BYPASS_VPN=off
